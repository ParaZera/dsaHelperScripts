{
    "name": "update-dsa-sheet",
    "build": {
        "context": ".",
        "dockerfile": "Dockerfile",
        "args": {
            "TZ": "${localEnv:TZ:Europe/Berlin}",
            "CLAUDE_CODE_VERSION": "latest",
            "GIT_DELTA_VERSION": "0.18.2",
            "ZSH_IN_DOCKER_VERSION": "1.2.0",
            "GLAB_VERSION": "1.82.0"
        }
    },
    // NET_ADMIN + NET_RAW needed for the firewall script (iptables/ipset)
    "runArgs": [
        "--cap-add=NET_ADMIN",
        "--cap-add=NET_RAW"
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "anthropic.claude-code",
                "ms-python.python",
                "charliermarsh.ruff",
                "eamodio.gitlens"
            ],
            "settings": {
                "terminal.integrated.defaultProfile.linux": "zsh",
                "terminal.integrated.profiles.linux": {
                    "zsh": { "path": "zsh" },
                    "bash": { "path": "bash", "icon": "terminal-bash" }
                },
                "python.defaultInterpreterPath": "/usr/local/bin/python",
                "[python]": {
                    "editor.defaultFormatter": "charliermarsh.ruff",
                    "editor.formatOnSave": true
                },
                "python.testing.pytestEnabled": true
            }
        }
    },
    "remoteUser": "python",
    "mounts": [
        // Persist command history across container rebuilds
        "source=dsa-sheet-bashhistory-${devcontainerId},target=/commandhistory,type=volume",
        // Persist Claude config/session across container rebuilds
        "source=dsa-sheet-claude-config-${devcontainerId},target=/home/python/.claude,type=volume",
        // Forward SSH agent (for GitLab, GitHub, etc.)
        "source=${localEnv:SSH_AUTH_SOCK},target=/ssh-agent,type=bind"
    ],
    "containerEnv": {
        "CLAUDE_CONFIG_DIR": "/home/python/.claude",
        "POWERLEVEL9K_DISABLE_GITSTATUS": "true",
        "SSH_AUTH_SOCK": "/ssh-agent",
        "GITLAB_HOST": "gitlab.com",
        // Allow pip/uv to resolve from PyPI through the firewall
        "EXTRA_ALLOWED_DOMAINS": "pypi.org files.pythonhosted.org pypi.astral.sh"
    },
    // Bind-mount your workspace into the container
    "workspaceMount": "source=${localWorkspaceFolder},target=/workdir,type=bind,consistency=delegated",
    "workspaceFolder": "/workdir",
    // Install project dependencies, then start the firewall
    "postCreateCommand": "uv sync",
    "postStartCommand": "sudo /usr/local/bin/init-firewall.sh",
    "waitFor": "postStartCommand"
}
